{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "email-ai-assistant",
  "main": "src/index.js",
  "compatibility_date": "2026-10-30",
  "observability": {
    "enabled": true
  },
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "EMAIL_MEMORY",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ]
}
